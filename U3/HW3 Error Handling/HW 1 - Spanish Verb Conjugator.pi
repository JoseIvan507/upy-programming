try:
    palabra = input("Ingrese una palabra en infinitivo: ").strip().lower()

    if not palabra.isalpha():
        print("Error: ingrese solo letras, sin números ni símbolos.")
    elif len(palabra) < 3:
        print("Error: la palabra debe tener al menos 3 letras (raíz + terminación).")
    else:
        pronombres = ["yo", "tú", "él", "nosotros", "vosotros", "ellos"]
        terminaciones = {
            "ar": ["o", "as", "a", "amos", "áis", "an"],
            "er": ["o", "es", "e", "emos", "éis", "en"],
            "ir": ["o", "es", "e", "imos", "ís", "en"],
        }
        raiz = palabra[:-2]
        final = palabra[-2:]
        if final in terminaciones:
            for pronombre, sufijo in zip(pronombres, terminaciones[final]):
                print(f"{pronombre} {raiz}{sufijo}")
        else:
            print("Error: la palabra debe terminar en -ar, -er o -ir.")
except (KeyboardInterrupt, EOFError):
    print("\nEntrada cancelada por el usuario.")
